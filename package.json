{
  "name": "my-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/optimize-hero.mjs && node ./node_modules/astro/astro.js dev --host 0.0.0.0",
    "build": "node scripts/optimize-hero.mjs && node ./node_modules/astro/astro.js build",
    "test:hero": "node --test scripts/hero-loader.test.mjs scripts/hero-renderer.test.mjs scripts/hero-entrance.test.mjs",
    "test:motion": "node --test scripts/motion-math.test.mjs scripts/hero-frame-motion.test.mjs scripts/division-layout.test.mjs scripts/home-opening.test.mjs scripts/home-research.test.mjs",
    "preview": "node ./node_modules/astro/astro.js preview",
    "astro": "node ./node_modules/astro/astro.js",
    "set-logo": "node scripts/set-logo.mjs"
  },
  "dependencies": {
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "sharp": "0.34.5"
  }
}
