---
interface Props {
  name: 'email' | 'crick' | 'location' | 'github' | 'linkedin' | 'bluesky';
}

const { name } = Astro.props;
---

<span class="contact-glyph" aria-hidden="true">
  {name === 'github' ? (
    <img src="/images/github-black.png" alt="" width="18" height="18" decoding="async" />
  ) : name === 'crick' ? (
    <img src="/images/crick-mark.svg" alt="" width="18" height="18" decoding="async" />
  ) : (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      {name === 'email' && <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </>}
      {name === 'location' && <>
        <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" />
        <circle cx="12" cy="10" r="2.5" />
      </>}
      {name === 'linkedin' && <>
        <circle cx="5" cy="4.5" r="2.1" fill="currentColor" stroke="none" />
        <path fill="currentColor" stroke="none" d="M3 8h4v13H3ZM10 8h4v1.8c.7-1.3 2-2.1 3.5-2.1 3.5 0 4.5 2.1 4.5 5.5V21h-4v-7c0-1.6-.4-2.7-1.9-2.7S14 12.5 14 14v7h-4Z" />
      </>}
      {name === 'bluesky' && (
        // Bluesky mark: https://github.com/simple-icons/simple-icons/blob/develop/icons/bluesky.svg
        <path fill="currentColor" stroke="none" d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026" />
      )}
    </svg>
  )}
</span>

<style>
  .contact-glyph {
    display: inline-flex;
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
  }

  .contact-glyph img,
  .contact-glyph svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

</style>
