---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About"
  theme="about"
  description="Structural biologist at the MRC Laboratory of Molecular Biology."
>
  <section class="container hero hero-top hero-wide">
    <div class="hero-primary">
      <h1>Sami <span class="name-tail">Chaaban <span class="phd-mark">PhD</span></span></h1>
      <p class="lead">
        Investigator Scientist at the MRC Laboratory of Molecular Biology in Cambridge, UK.
      </p>
      <p class="meta">
        I am a molecular and structural biologist with a broad background in studying
        the architecture and mechanisms of protein assemblies using biochemistry,
        cryo-electron microscopy, and fluorescence microscopy.
      </p>
      <p class="meta">
        My research spans from elucidating the structural basis of cytoskeletal
        function to developing software tools that streamline computational workflows.
      </p>
    </div>
    <div class="hero-media">
      <img
        class="headshot"
        src="/images/headshot.jpg"
        alt="Sami Chaaban"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

</Layout>

<style>
  .hero-top {
    align-items: flex-start;
  }

  .hero-wide {
    grid-template-columns: minmax(0, 0.98fr) minmax(380px, 1.02fr);
    gap: clamp(1.4rem, 2.6vw, 2.8rem);
  }

  .hero-primary {
    max-width: none;
    margin: 0;
  }

  .hero-media {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .hero-primary h1 {
    font-size: clamp(3rem, 5vw, 4.2rem);
  }

  .name-tail {
    white-space: nowrap;
  }

  .phd-mark {
    display: inline-block;
    margin-left: 0.28em;
    font-size: 0.26em;
    font-weight: 500;
    letter-spacing: 0.12em;
    font-family: var(--font-body);
    color: var(--muted);
    line-height: 1;
    white-space: nowrap;
    vertical-align: baseline;
    transform: none;
    opacity: 0.9;
  }

  .hero-primary .lead {
    font-size: 1.35rem;
  }

  .hero-primary .meta {
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .headshot {
    display: block;
    width: min(100%, 760px);
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 761px) {
    .headshot {
      clip-path: inset(0 0 0 9% round var(--radius-lg));
    }
  }

  @media (max-width: 900px) {
    .hero-wide {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-media {
      justify-content: flex-start;
    }

    .headshot {
      margin-top: 0.4rem;
      width: min(100%, 700px);
      height: auto;
      aspect-ratio: auto;
    }
  }
</style>
