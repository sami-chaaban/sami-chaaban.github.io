---
import { readFileSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';
import LinkArrow from '../components/LinkArrow.astro';
import { cellPath } from '../lib/home-cell';
const manifestPath = new URL('../../public/images/hero-optimized/manifest.json', import.meta.url);
const { mobile, desktop } = JSON.parse(readFileSync(manifestPath, 'utf8')) as { mobile: string[]; desktop: string[] };
const cellOutline = cellPath(0);
const finalLinks = [
  { label: 'Crick Lab Profile', href: 'https://www.crick.ac.uk/research/labs/sami-chaaban', external: true },
  { label: 'Publications', href: '/research/' },
  { label: 'Software', href: '/software/' },
  { label: 'Contact', href: '/contact/' },
];
---
<Layout title="Home" theme="about" description="The Chaaban Lab studies cytoskeletal coordination during cell division.">
  <div class="home-story" data-fluid-home data-frames={JSON.stringify(desktop)} data-mobile-frames={JSON.stringify(mobile)}>
    <div class="molecular-scene" aria-hidden="true">
      <div class="scene-camera" data-scene-camera>
        <div class="scene-drift">
          <picture>
            <source media="(max-width: 780px) and (orientation: portrait)" srcset={mobile[0]} />
            <img class="scene-frame" data-scene-poster src={desktop[0]} alt="" width="2070" height="936" loading="eager" fetchpriority="high" decoding="async" />
          </picture>
          <canvas class="scene-frame scene-canvas" data-scene-canvas></canvas>
        </div>
      </div>
      <div class="scene-shade" data-scene-shade></div>
      <div class="scene-veil" data-scene-veil></div>
    </div>
    <div class="home-opening-sequence" data-opening-sequence>
    <section class="home-hero" data-opening-stage aria-labelledby="home-title">
      <div class="story-width hero-content" data-hero-copy>
        <p class="home-eyebrow" data-motion>Francis Crick Institute · London</p>
        <h1 id="home-title" aria-label="Chaaban Lab">
          <span class="title-line"><span data-motion data-delay="80">Chaaban</span></span>
          <span class="title-line"><span data-motion data-delay="180">Lab</span></span>
        </h1>
      </div>
      <div class="story-width hero-bottom" data-hero-footer>
        <p class="home-opening"><span class="opening-dot" aria-hidden="true"></span>Lab opens <strong>January 2027</strong></p>
        <a class="scroll-cue" href="#our-research"><span>Explore our research</span><span class="scroll-line" aria-hidden="true"></span></a>
      </div>
    </section>
    </div>
    <div class="home-research-sequence" data-research-sequence>
    <section id="our-research" class="home-inquiry story-width" aria-labelledby="research-question">
      <h2 id="research-question" class="section-heading">How do cells <span class="word-organize">organize</span> and <span class="word-reshape">reshape</span> themselves?</h2>
      <div class="inquiry-copy">
        <div class="inquiry-intro">
        <p>Cells rely on their internal scaffolding, the cytoskeleton, and molecular motors to organise their contents, change shape and divide.</p>
        <p>We want to understand how these systems work together, and how their activity is coordinated with the reshaping of cell membranes.</p>
        </div>
        <div class="inquiry-focus-reveal">
        <p class="inquiry-focus" data-research-focus>A central focus is the final stages of cell division: building the bridge between daughter cells and making the cut that separates them.</p>
        </div>
      </div>
    </section>
    </div>
    <section class="home-division" data-division aria-label="Our research into cell division">
      <div class="division-stage">
        <div class="division-composition story-width">
          <div class="cell-diagram" aria-hidden="true">
            <svg viewBox="0 0 720 320" preserveAspectRatio="none" fill="none" focusable="false">
              <defs>
                <linearGradient id="cell-fill" x1="0" y1="0" x2="720" y2="320" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#0b242a" stop-opacity="0.93" /><stop offset="1" stop-color="#0d3336" stop-opacity="0.9" />
                </linearGradient>
                <linearGradient id="cell-edge" x1="0" y1="0" x2="720" y2="320" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#a5f1df" stop-opacity="0.65" /><stop offset="0.5" stop-color="#76e2d9" stop-opacity="0.18" /><stop offset="1" stop-color="#a5f1df" stop-opacity="0.55" />
                </linearGradient>
              </defs>
              <path data-cell-path d={cellOutline} fill="url(#cell-fill)" stroke="url(#cell-edge)" stroke-width="1" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
          <div class="division-copy">
            <article class="division-half">
              <span class="chapter-number" aria-hidden="true">01</span><h2>Building<br /> the bridge</h2>
              <p>How do cells organise their internal scaffolding to position the machinery that separates daughter cells?</p>
            </article>
            <article class="division-half" data-division-cut>
              <span class="chapter-number" aria-hidden="true">02</span><h2>Making<br /> the final cut</h2>
              <p>How do molecular machines reshape the membrane and cytoskeleton to complete division?</p>
            </article>
          </div>
        </div>
        <div class="division-progress" aria-hidden="true"><span data-division-progress></span></div>
      </div>
    </section>
    <section class="home-outro story-width" aria-label="Explore the lab">
      <figure class="home-profile" data-motion>
        <img class="home-portrait" src="/images/headshot.jpg" alt="Sami Chaaban" width="1500" height="1000" loading="lazy" decoding="async" />
        <figcaption>Sami Chaaban</figcaption>
      </figure>
      <nav class="home-links" aria-label="Explore the lab">
        {finalLinks.map(({ label, href, external }, index) => (
          <a class="home-link" href={href} data-motion data-delay={index * 60}>
            <span>{label}</span><span class="home-link-arrow" aria-hidden="true"><LinkArrow direction={external ? 'up-right' : 'right'} /></span>
          </a>
        ))}
      </nav>
    </section>
  </div>
</Layout>
<script>
  import { initFluidHome } from '../lib/home-fluidity';
  const home = document.querySelector<HTMLElement>('[data-fluid-home]');
  if (home) initFluidHome(home);
</script>
<style>
  :global(html[data-theme='about']) { --bg: #071419; --text: #f1f7f5; --muted: #b1c7c8; --accent: #8ce5d4; --accent-2: #8ce5d4; background: #071419; }
  :global(html[data-theme='about'] body) { background: #071419; overflow-x: clip; }
  :global(html[data-theme='about'] body::before), :global(html[data-theme='about'] body::after) { display: none; }
  :global(html[data-theme='about'] .page) { background: transparent; }
  :global(html[data-theme='about'] .site-main) { padding: 0; }
  :global(html[data-theme='about'] .site-footer) { padding: 1rem 0 1.5rem; }
  :global(html[data-theme='about'] .footer-inner) { flex-direction: row; flex-wrap: wrap; align-items: center; padding-top: 1rem; }
  .home-story { position: relative; isolation: isolate; color: #f1f7f5; }
  .story-width { width: min(1360px, calc(100% - 7rem)); margin-inline: auto; }
  .molecular-scene { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: #071419; }
  .scene-camera, .scene-drift, .scene-shade, .scene-veil { position: absolute; inset: 0; }
  .scene-frame { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 58% center; }
  .scene-canvas { opacity: 0; }
  .scene-shade { background: linear-gradient(90deg, rgba(3, 13, 18, 0.77), rgba(3, 13, 18, 0.22) 76%), linear-gradient(0deg, rgba(5, 18, 23, 0.72), transparent 65%); }
  .scene-veil { background: #071419; opacity: 0.35; }
  .home-opening-sequence { position: relative; min-height: 180svh; }
  .home-hero { position: sticky; top: 0; min-height: 100svh; display: flex; align-items: center; padding-block: 9rem 11rem; }
  .hero-content { padding-top: 4rem; will-change: transform, opacity; }
  .home-eyebrow { margin: 0 0 2rem; font-size: 0.9rem; letter-spacing: 0.13em; font-weight: 500; color: #b5e5d9; }
  h1 { margin: 0; color: #fff; font-family: 'Zilla Slab', 'Figtree', 'Segoe UI', sans-serif; font-size: clamp(4.2rem, 8vw, 7.6rem); line-height: 0.82; letter-spacing: -0.06em; font-weight: 700; text-transform: uppercase; }
  .title-line { display: block; overflow: clip; padding: 0.04em 0.08em 0.12em 0; margin-bottom: -0.07em; }
  .title-line > span { display: inline-block; }
  .hero-bottom { position: absolute; inset: auto 0 2.5rem; display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
  .home-opening { display: flex; align-items: center; flex-wrap: wrap; gap: 0.35em; margin: 0; font-size: 0.95rem; color: #d6e4e0; }
  .home-opening strong { color: #fff; font-weight: 500; }
  .opening-dot { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: #8ce5d4; margin-right: 0.5rem; box-shadow: 0 0 16px rgba(140, 229, 212, 0.55); }
  .scroll-cue { display: flex; align-items: center; gap: 1.1rem; font-size: 0.9rem; color: #d6e4e0; }
  .scroll-line { width: 1px; height: 2.75rem; position: relative; background: rgba(214, 228, 224, 0.25); overflow: hidden; }
  .scroll-line::after { content: ''; position: absolute; inset: 0; background: #8ce5d4; transform-origin: top; animation: scroll-trace 2.5s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
  .home-research-sequence { position: relative; height: var(--research-sequence-height, auto); pointer-events: none; }
  .home-inquiry { position: sticky; top: var(--research-pin-top, 0px); min-height: 100svh; padding-block: clamp(3rem, 8svh, 6rem); display: grid; grid-template-columns: 1.12fr 1fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); scroll-margin-top: 3rem; pointer-events: auto; }
  .home-inquiry[inert] { pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .home-research-sequence { margin-top: -100svh; }
  }
  .section-heading { max-width: 15ch; margin: 0; font-size: clamp(2.75rem, 4.6vw, 5.4rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1.08; }
  .section-heading .word-organize { color: #8ce5d4; }
  .section-heading .word-reshape { color: #a6bcff; }
  .inquiry-copy { max-width: 37rem; transform: translate3d(0, var(--research-copy-offset, 0px), 0); }
  .inquiry-copy p { margin: 0 0 1.5rem; color: #bfd0d0; font-size: clamp(1.125rem, 1.45vw, 1.5rem); line-height: 1.65; }
  .inquiry-intro p:last-child { margin-bottom: 0; }
  .inquiry-focus-reveal { margin-top: 2.2rem; overflow: clip; }
  .inquiry-copy .inquiry-focus { margin: 0; padding-top: 2.2rem; border-top: 1px solid rgba(140, 229, 212, 0.25); color: #f1f7f5; transition: opacity 180ms linear, transform 180ms var(--ease-fluid); }
  .home-division { min-height: 200svh; }
  .division-stage { position: sticky; top: 0; min-height: 100svh; padding-block: 5rem; display: flex; align-items: center; }
  .division-composition { position: relative; max-width: 1200px; }
  .cell-diagram { position: absolute; inset: 50% 0 auto; transform: translateY(-50%); }
  .cell-diagram svg { display: block; width: 100%; height: auto; overflow: visible; }
  .division-copy { position: relative; display: grid; grid-template-columns: 4fr 1fr 4fr; }
  .division-half { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 2.5rem 1.8rem; }
  .division-half:last-child { grid-column: 3; }
  [data-division-cut] { will-change: opacity, transform; }
  .chapter-number { font-family: var(--font-body); font-size: 0.875rem; letter-spacing: 0.12em; color: #8ce5d4; margin-bottom: 1.5rem; }
  .division-half h2 { margin: 0; font-size: clamp(2.4rem, 3.5vw, 3.65rem); line-height: 1.08; font-weight: 500; letter-spacing: -0.045em; }
  .division-half p { max-width: 29ch; margin: 1.5rem 0 0; font-size: clamp(1rem, 1.25vw, 1.25rem); line-height: 1.55; color: #bfd0d0; }
  .division-progress { position: absolute; left: 50%; bottom: 0; width: 7rem; height: 1px; background: rgba(140, 229, 212, 0.15); transform: translateX(-50%); }
  .division-progress span { display: block; width: 100%; height: 100%; background: #8ce5d4; transform: scaleX(0); transform-origin: left; }
  .home-outro { min-height: 90svh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(4rem, 10vw, 10rem); padding-block: 6rem 3rem; }
  .home-profile { margin: 0; text-align: center; width: 100%; max-width: min(30rem, calc(100svh - 12rem)); }
  .home-portrait { display: block; width: 100%; height: auto; aspect-ratio: 1; border-radius: 50%; object-fit: cover; border: 1px solid rgba(140, 229, 212, 0.2); }
  .home-profile figcaption { font-family: var(--font-display); font-size: 1.75rem; margin-top: 1.5rem; }
  .home-links { width: 100%; }
  .home-link { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1.8rem 0; border-bottom: 1px solid rgba(140, 229, 212, 0.23); font-family: var(--font-display); font-size: clamp(1.7rem, 2.8vw, 2.65rem); font-weight: 500; letter-spacing: -0.025em; transition: color 300ms var(--ease-fluid, ease); }
  .home-link:first-child { border-top: 1px solid rgba(140, 229, 212, 0.23); }
  .home-link > span:first-child { transition: transform 500ms var(--ease-fluid, ease); }
  .home-link-arrow { display: inline-flex; color: #8ce5d4; transition: transform 500ms var(--ease-fluid, ease); }
  .home-link:hover { color: #8ce5d4; }
  .home-link:hover > span:first-child { transform: translateX(0.4rem); }
  .home-link:hover .home-link-arrow { transform: translate(0.25rem, -0.15rem); }
  .home-story a:focus-visible { outline: 2px solid #8ce5d4; outline-offset: 8px; }
  @keyframes scroll-trace { 0% { transform: translateY(-100%); } 65%, 100% { transform: translateY(100%); } }
  @media (max-width: 1000px) {
    .story-width { width: calc(100% - 4rem); }
    .home-inquiry { grid-template-columns: 1fr; gap: 3.5rem; min-height: 100svh; padding-block: 8rem; }
    .section-heading { max-width: 16ch; }
    .inquiry-copy { max-width: 38rem; justify-self: end; }
    .division-half { padding-inline: 1rem; }
    .division-half h2 { font-size: 2.6rem; }
    .division-half p { font-size: 1rem; }
    .home-outro { gap: 4rem; }
    .home-division { min-height: var(--division-sequence-height, 200svh); }
    .division-stage { top: var(--division-pin-top, 0px); padding-block: 1rem; }
    .division-composition {
      container-type: inline-size;
      width: min(30rem, calc(100% - 2rem), calc((100svh - 2rem) * 4 / 9));
      aspect-ratio: 4 / 9;
    }
    .cell-diagram {
      inset: 50% auto auto 50%;
      width: 225cqw;
      height: 100cqw;
      transform: translate(-50%, -50%) rotate(90deg);
      opacity: 0.62;
    }
    .cell-diagram svg { height: 100%; }
    .division-copy {
      position: absolute;
      inset: 0;
      grid-template-columns: 1fr;
      grid-template-rows: 4fr 1fr 4fr;
      gap: 0;
    }
    .division-half {
      grid-row: 1;
      width: 80%;
      padding: 0;
      place-self: center;
    }
    .division-half:last-child { grid-column: 1; grid-row: 3; }
    .division-half h2 { font-size: clamp(1.5rem, 4.5vw, 1.75rem); }
    .division-half p { width: 100%; max-width: none; font-size: 1rem; line-height: 1.35; margin-top: 0.625rem; }
    .chapter-number { line-height: 1.4; margin-bottom: 0.5rem; }
    .division-progress { bottom: -1.5rem; }
  }
  @media (max-width: 660px) {
    .story-width { width: calc(100% - 3rem); }
    .division-composition { width: min(calc(100% - 2rem), calc((100svh - 2rem) * 4 / 9)); }
    .home-hero { align-items: flex-end; padding-block: 10rem 12rem; }
    .hero-content { padding-top: 0; }
    h1 { font-size: clamp(4rem, 19vw, 6rem); }
    .home-eyebrow { max-width: 25ch; font-size: 0.9rem; line-height: 1.7; margin-bottom: 1.5rem; }
    .hero-bottom { bottom: 2.25rem; align-items: flex-start; gap: 1.5rem; flex-direction: column; }
    .home-opening { font-size: 0.9rem; }
    .scroll-cue { font-size: 0.875rem; gap: 0.8rem; }
    .scroll-line { height: 1.8rem; }
    .scene-frame { object-position: 60% center; }
    .scene-shade { background: linear-gradient(0deg, rgba(3, 13, 18, 0.86), rgba(3, 13, 18, 0.34) 90%); }
    .home-inquiry { padding-block: 6rem; gap: 2.5rem; min-height: auto; }
    .section-heading { font-size: clamp(2.65rem, 9vw, 3.7rem); }
    .inquiry-copy p { font-size: 1.125rem; }
    .home-outro { min-height: auto; grid-template-columns: 1fr; justify-items: center; padding-block: 4rem 1rem; gap: 1.5rem; }
    .home-profile { max-width: min(20rem, calc(100svh - 23rem)); }
    .home-profile figcaption { font-size: 1.5rem; line-height: 1.2; margin-top: 0.75rem; }
    .home-link { font-size: 1.25rem; line-height: 1.2; padding-block: 0.75rem; }
    :global(html[data-theme='about'] .site-footer) { padding: 0.75rem 0 1rem; font-size: 0.875rem; line-height: 1.4; }
    :global(html[data-theme='about'] .footer-inner) { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem; padding-top: 0.75rem; }
  }
  @media (max-width: 480px) {
    h1 { font-size: clamp(3.6rem, 18vw, 5.1rem); }
  }
  @media (min-width: 661px) and (max-height: 700px) {
    .home-outro { padding-block: 3rem 2rem; }
    .home-link { font-size: 1.6rem; line-height: 1.2; padding-block: 0.75rem; }
  }
  @media (max-width: 1000px) and (max-height: 740px) {
    .division-half .chapter-number { display: none; }
  }
  @media (max-width: 1000px) and (orientation: landscape) {
    .division-composition {
      width: min(calc(100% - 2rem), calc((100svh - 2rem) * 9 / 4));
      aspect-ratio: 9 / 4;
    }
    .cell-diagram { width: 100cqw; height: calc(100cqw * 4 / 9); transform: translate(-50%, -50%); }
    .division-copy { grid-template-columns: 4fr 1fr 4fr; grid-template-rows: 1fr; }
    .division-half:last-child { grid-column: 3; grid-row: 1; }
  }
  @media (min-width: 1001px) and (max-height: 650px) {
    .division-stage { position: relative; min-height: 45rem; }
    .home-division { min-height: auto; }
    .division-progress { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .inquiry-copy .inquiry-focus { transition: none; }
    .home-opening-sequence { min-height: auto; }
    .home-hero { position: relative; }
    .home-research-sequence { height: auto; }
    .home-inquiry { position: relative; top: 0; }
    .scene-drift, .scroll-line::after { animation: none; }
    .scene-camera, .hero-content { transform: none !important; }
    .scene-canvas { display: none; }
    .home-division { min-height: auto; }
    .division-stage { position: relative; }
    .division-progress { display: none; }
    .home-link, .home-link > span, .home-link-arrow { transition: none; }
  }
</style>
