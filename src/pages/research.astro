---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Publications"
  theme="research"
  description="Publications from Sami Chaaban and the Chaaban Lab."
>
  <section class="parallax-hero publications-page">
    <div class="hero-media" aria-hidden="true">
      <img
        class="hero-image"
        src="/images/research-divider.png"
        alt=""
        loading="eager"
        decoding="async"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="container publications-block">
      <h1 class="publications-title">Publications</h1>
      <div class="meta pub-link">
        <a href="https://scholar.google.com/citations?hl=en&user=EXrfsYkAAAAJ" target="_blank" rel="noreferrer">Google Scholar profile</a>
      </div>
      <div class="list">
        <div class="list-item publication-with-right-image" data-publication-year="2026">
          <div class="publication-body">
            <strong>
              <a href="https://www.biorxiv.org/content/10.64898/2026.04.25.720804v1" target="_blank" rel="noreferrer">
                Structural basis of dynein interaction with diverse activating adaptors
              </a>
            </strong>
            <div class="meta">d'Amico EA, <span class="author-highlight">Chaaban S</span>, Abid Ali F, Michalski L, Carter AP.</div>
            <div class="meta">bioRxiv - 2026</div>
          </div>
          <img
            class="publication-right-image"
            src="/images/research-adaptors.png"
            alt="Structures of dynein-dynactin complexes assembled with diverse activating adaptors"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="list-item publication-with-right-image" data-publication-year="2025">
          <div class="publication-body publication-with-cover">
            <img
              class="publication-cover-image"
              src="/images/research-asgardcover.jpg"
              alt="Science Advances cover featuring Asgard archaea research"
              loading="lazy"
              decoding="async"
            />
            <div class="publication-text">
              <strong>
                <a href="https://pubmed.ncbi.nlm.nih.gov/39919172/" target="_blank" rel="noreferrer">
                  Asgard archaea reveal the conserved principles of ESCRT-III membrane remodeling
                </a>
              </strong>
              <div class="meta">Souza DP*, Espadas J*, <span class="author-highlight">Chaaban S*</span>, Moody ERR, Hatano T, Balasubramanian M, Williams TA, Roux A, Baum B.</div>
              <div class="meta">Science Advances - 2025</div>
            </div>
          </div>
          <img
            class="publication-right-image"
            src="/images/research-asgard.png"
            alt="Asgard archaea ESCRT-III membrane remodeling figure"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="list-item publication-with-image" data-publication-year="2024">
          <img
            class="publication-side-image"
            src="/images/research-mtbd.png"
            alt="Dynein microtubule-binding domain visualization"
            loading="lazy"
            decoding="async"
          />
          <div class="publication-body">
            <strong>
              <a href="https://pubmed.ncbi.nlm.nih.gov/38949648/" target="_blank" rel="noreferrer">
                A force-sensitive mutation reveals a non-canonical role for dynein in anaphase progression
              </a>
            </strong>
            <div class="meta">Salvador-Garcia D, Jin L, Hensley A, Golcuk M, Gallaud E, <span class="author-highlight">Chaaban S</span>, Port F, Vagnoni A, Planelles-Herrero VJ, McClintock MA, Derivery E, Carter AP, Giet R, Gur M, Yildiz A, Bullock SL.</div>
            <div class="meta">Journal of Cell Biology - 2024</div>
          </div>
        </div>
        <div class="list-item publication-with-image" data-publication-year="2024">
          <img
            class="publication-side-image"
            src="/images/research-predictions.png"
            alt="Protein structure prediction visualization"
            loading="lazy"
            decoding="async"
          />
          <div class="publication-body">
            <strong>
              <a href="https://portlandpress.com/biochemist/article/46/2/7/234398/AI-told-you-so-navigating-protein-structure" target="_blank" rel="noreferrer">
                Navigating protein structure prediction in the era of machine learning
              </a>
            </strong>
            <div class="meta"><span class="author-highlight">Chaaban S*</span>, Ratkevičiūtė G*, Lau C*.</div>
            <div class="meta">The Biochemist - 2024</div>
          </div>
        </div>
        <div class="list-item publication-with-right-image" data-publication-year="2022">
          <div class="publication-body publication-with-cover">
            <img
              class="publication-cover-image"
              src="/images/research-naturecover.png"
              alt="Nature cover featuring dynein-dynactin structure"
              loading="lazy"
              decoding="async"
            />
            <div class="publication-text">
              <strong>
                <a href="https://pubmed.ncbi.nlm.nih.gov/36071160/" target="_blank" rel="noreferrer">
                  Structure of dynein-dynactin on microtubules shows tandem adaptor binding
                </a>
              </strong>
              <div class="meta"><span class="author-highlight">Chaaban S</span>, Carter AP.</div>
              <div class="meta">Nature - 2022</div>
            </div>
          </div>
          <img
            class="publication-right-image"
            src="/images/research-dyneinstructure.jpg"
            alt="Dynein-dynactin structure on microtubules"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="list-item publication-with-cover" data-publication-year="2021">
          <img
            class="publication-cover-image"
            src="/images/research-pacrg.jpg"
            alt="PACRG-MEIG1 complex structure"
            loading="lazy"
            decoding="async"
          />
          <div class="publication-text">
            <strong>
              <a href="https://pubmed.ncbi.nlm.nih.gov/33529594/" target="_blank" rel="noreferrer">
                Crystal structure of human PACRG in complex with MEIG1 reveals roles in axoneme formation and tubulin binding
              </a>
            </strong>
            <div class="meta">Khan N, Pelletier D, McAlear TS, Croteau N, Veyron S, Bayne A, Black C, Ichikawa I, Khalifa AAZ, <span class="author-highlight">Chaaban S</span>, Kurinov I, Brouhard GJ, Bechstedt S, Bui KH, Trempe J-F.</div>
            <div class="meta">Structure - 2021</div>
          </div>
        </div>
        <div class="list-item publication-with-right-image" data-publication-year="2018">
          <div class="publication-body publication-with-cover">
            <img
              class="publication-cover-image"
              src="/images/research-celeganscover.jpg"
              alt="Cover featuring C. elegans tubulin study"
              loading="lazy"
              decoding="async"
            />
            <div class="publication-text">
              <strong>
                <a href="https://pubmed.ncbi.nlm.nih.gov/30245157/" target="_blank" rel="noreferrer">
                  The structure and dynamics of <em>C. elegans</em> tubulin reveals the mechanistic basis of microtubule growth
                </a>
              </strong>
              <div class="meta"><span class="author-highlight">Chaaban S</span>, Jariwala S, Hsu C-T, Redemann S, Kollman JM, Muller-Reichert T, Sept D, Bui KH, Brouhard GJ.</div>
              <div class="meta">Developmental Cell - 2018</div>
            </div>
          </div>
          <img
            class="publication-right-image"
            src="/images/research-celegans.jpg"
            alt="C. elegans tubulin structure"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="list-item publication-with-right-image" data-publication-year="2017">
          <div class="publication-body publication-with-cover">
            <img
              class="publication-cover-image"
              src="/images/research-bestiarycover.jpg"
              alt="Microtubule bestiary cover"
              loading="lazy"
              decoding="async"
            />
            <div class="publication-text">
              <strong>
                <a href="https://pubmed.ncbi.nlm.nih.gov/29084910/" target="_blank" rel="noreferrer">
                  A microtubule bestiary: structural diversity in tubulin polymers
                </a>
              </strong>
              <div class="meta"><span class="author-highlight">Chaaban S</span>, Brouhard GJ.</div>
              <div class="meta">Molecular Biology of the Cell - 2017</div>
            </div>
          </div>
          <img
            class="publication-right-image"
            src="/images/research-bestiary.png"
            alt="Microtubule bestiary figure"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="list-item publication-with-cover" data-publication-year="2016">
          <img
            class="publication-cover-image"
            src="/images/research-dza.jpg"
            alt="Diazonamide DZ-2384 microtubule curvature study"
            loading="lazy"
            decoding="async"
          />
          <div class="publication-text">
            <strong>
              <a href="https://pubmed.ncbi.nlm.nih.gov/27856798/" target="_blank" rel="noreferrer">
                The synthetic diazonamide DZ-2384 has distinct effects on microtubule curvature and dynamics without neurotoxicity
              </a>
            </strong>
            <div class="meta">Wieczorek M, Tcherkezian J, Bernier C, Prota AE, <span class="author-highlight">Chaaban S</span>, Rolland Y, Godbout C, Hancock MA, Arezzo JC, Ocal O, Rocha C, Olieric N, Hall A, Ding H, Bramoulle A, Annis MG, Zogopoulos G, Harran PG, Wilkie TM, Brekken RA, Siegel PM, Steinmetz MO, Shore GC, Brouhard GJ, Roulston A.</div>
            <div class="meta">Science Translational Medicine - 2016</div>
          </div>
        </div>
        <div class="list-item publication-with-cover" data-publication-year="2015">
          <img
            class="publication-cover-image"
            src="/images/research-nucleationcover.png"
            alt="Microtubule nucleation cover"
            loading="lazy"
            decoding="async"
          />
          <div class="publication-text">
            <strong>
              <a href="https://pubmed.ncbi.nlm.nih.gov/26098575/" target="_blank" rel="noreferrer">
                Microtubule-associated proteins control the kinetics of microtubule nucleation
              </a>
            </strong>
            <div class="meta">Wieczorek M, Bechstedt S, <span class="author-highlight">Chaaban S</span>, Brouhard GJ.</div>
            <div class="meta">Nature Cell Biology - 2015</div>
          </div>
        </div>
        <div class="list-item publication-with-cover" data-publication-year="2013">
          <img
            class="publication-cover-image"
            src="/images/research-crowdingcover.png"
            alt="Macromolecular crowding cover"
            loading="lazy"
            decoding="async"
          />
          <div class="publication-text">
            <strong>
              <a href="https://link.springer.com/article/10.1007/s12195-013-0292-9" target="_blank" rel="noreferrer">
                Macromolecular crowding pushes catalyzed microtubule growth to near the theoretical limit
              </a>
            </strong>
            <div class="meta">Wieczorek M*, <span class="author-highlight">Chaaban S*</span>, Brouhard GJ.</div>
            <div class="meta">Cellular and Molecular Bioengineering - 2013</div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="publication-year" aria-hidden="true"></div>
</Layout>

<script>
  const zoomablePubs = document.querySelectorAll('.publication-right-image');
  zoomablePubs.forEach((img) => {
    img.addEventListener('click', () => {
      const isZoomed = img.classList.contains('is-zoomed');
      const parentCard = img.closest('.list-item');
      if (isZoomed) {
        img.classList.remove('is-zoomed');
        parentCard?.classList.remove('is-zoomed');
        return;
      }
      zoomablePubs.forEach((item) => {
        item.classList.remove('is-zoomed');
        item.closest('.list-item')?.classList.remove('is-zoomed');
      });
      const rect = img.getBoundingClientRect();
      const anchor = rect.left <= window.innerWidth - rect.right ? 'left' : 'right';
      img.dataset.zoomAnchor = anchor;
      img.classList.add('is-zoomed');
      parentCard?.classList.add('is-zoomed');
    });
  });

  const publicationCards = document.querySelectorAll('.publications-block .list-item');
  publicationCards.forEach((card) => {
    const link = card.querySelector('strong a[href]');
    if (!(link instanceof HTMLAnchorElement)) return;
    const destination = link.getAttribute('href');
    if (!destination) return;

    card.classList.add('is-clickable');
    card.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('a, button, input, textarea, select, label')) return;
      if (target.closest('.publication-right-image, .publication-side-image, .publication-cover-image')) return;
      if (window.getSelection && window.getSelection()?.toString()) return;
      window.open(destination, '_blank', 'noopener,noreferrer');
    });
  });

  const yearOverlay = document.querySelector<HTMLElement>('.publication-year');
  const publicationList = document.querySelector<HTMLElement>('.publications-block .list');
  const datedCards = Array.from(document.querySelectorAll<HTMLElement>('[data-publication-year]'));

  if (yearOverlay && publicationList && datedCards.length) {
    const yearLayers = new Map<string, HTMLSpanElement>();
    datedCards.forEach((card) => {
      const year = card.dataset.publicationYear!;
      if (yearLayers.has(year)) return;
      const layer = document.createElement('span');
      layer.className = 'publication-year-value';
      layer.textContent = year;
      yearLayers.set(year, layer);
      yearOverlay.append(layer);
    });

    let currentYear = '';
    let frame = 0;
    const updateYear = () => {
      frame = 0;
      // Follow the card at the reading line, including tall cards on mobile.
      const readingLine = window.innerHeight * 0.4;
      const listBounds = publicationList.getBoundingClientRect();
      const isVisible = listBounds.top < window.innerHeight * 0.85 && listBounds.bottom > readingLine;
      let activeCard = datedCards[0];
      for (const card of datedCards) {
        if (card.getBoundingClientRect().top > readingLine) break;
        activeCard = card;
      }

      const nextYear = activeCard.dataset.publicationYear!;
      if (nextYear !== currentYear) {
        yearLayers.get(currentYear)?.classList.remove('is-current');
        yearLayers.get(nextYear)?.classList.add('is-current');
        currentYear = nextYear;
      }
      yearOverlay.classList.toggle('is-visible', isVisible);
    };

    const scheduleYearUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateYear);
    };
    window.addEventListener('scroll', scheduleYearUpdate, { passive: true });
    window.addEventListener('resize', scheduleYearUpdate);
    window.addEventListener('pageshow', scheduleYearUpdate);
    // Lazy-loaded images can change where later publications begin.
    new ResizeObserver(scheduleYearUpdate).observe(publicationList);
    updateYear();
  }
</script>

<style>
  .publications-page {
    padding: 0 0 4.5rem;
  }

  .glass-panel {
    background: rgba(255, 255, 255, 0.08);
    background: color-mix(in srgb, var(--text) 6%, transparent);
    border-color: color-mix(in srgb, var(--text) 16%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .parallax-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(10.5rem, 20vh, 13rem) 0 4.5rem;
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .parallax-hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-media {
    position: fixed;
    top: var(--header-offset, 96px);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    pointer-events: none;
    background: transparent;
  }

  .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
    transform: translateY(0);
    will-change: transform;
    filter: saturate(1.05);
    opacity: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: none;
  }

  .glass {
    padding: 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 65%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--shadow-md);
  }

  .parallax-hero .card {
    background: color-mix(in srgb, var(--surface) 65%, transparent);
    border-color: color-mix(in srgb, var(--border) 90%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--shadow-md);
  }

  .parallax-hero .hero {
    align-items: flex-start;
  }

  .parallax-hero .card {
    padding: 1rem;
  }

  .parallax-hero .card h3 {
    margin-bottom: 0.4rem;
  }

  .publications-block {
    --publications-title-lift: clamp(4rem, calc(16rem - 16vw), 9rem);
    margin-top: 0;
  }

  .publications-title {
    margin: 0 0 1rem;
    transform: translateY(calc(-1 * var(--publications-title-lift)));
    font-size: clamp(2.6rem, 3.2vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-align: left;
  }

  .pub-link {
    margin: 0 0 1rem;
  }

  .publication-year {
    position: fixed;
    right: clamp(1.25rem, 4vw, 4rem);
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    z-index: 6;
    display: grid;
    pointer-events: none;
    user-select: none;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 0.85;
    letter-spacing: -0.055em;
    color: rgba(225, 236, 255, 0.36);
    text-shadow: 0 2px 20px rgba(6, 10, 26, 0.3);
    opacity: 0;
    transition: opacity 350ms ease;
  }

  .publication-year.is-visible {
    opacity: 1;
  }

  .publication-year :global(.publication-year-value) {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 450ms ease;
  }

  .publication-year :global(.publication-year-value.is-current) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .publication-year,
    .publication-year :global(.publication-year-value) {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .parallax-hero {
      padding: 8rem 0 4rem;
    }

    .hero-media {
      position: absolute;
      top: 0;
      bottom: 0;
    }

    .glass {
      padding: 1.6rem;
    }

    .publications-block {
      margin-top: 3rem;
    }

  }

  @media (max-width: 600px) {
    .parallax-hero {
      padding: 6rem 0 3.5rem;
    }

    .hero-image {
      object-position: top center;
    }
  }

  @media (max-width: 540px) {
    .publications-title {
      transform: none;
    }
  }

  .publications-block .list-item strong {
    font-size: 1.15rem;
  }

  .publications-block .list-item .meta {
    font-size: 1rem;
  }

  .publications-block .list {
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .publications-block .list-item {
    background: linear-gradient(145deg, rgba(30, 40, 72, 0.96), rgba(18, 25, 48, 0.96));
    border-color: rgba(155, 181, 229, 0.4);
    box-shadow:
      0 12px 24px -16px rgba(0, 0, 0, 0.72),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .publications-block .list-item.is-clickable {
    cursor: pointer;
  }

  .publications-block .list-item.is-zoomed {
    position: relative;
    z-index: 40;
  }

  @media (hover: hover) and (pointer: fine) {
    .publications-block .list-item.is-clickable:hover,
    .publications-block .list-item.is-clickable:focus-within {
      transform: scale(1.01);
      border-color: rgba(155, 181, 229, 0.7);
      box-shadow:
        0 16px 32px -16px rgba(0, 0, 0, 0.78),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
  }

  .publication-with-image {
    display: grid;
    grid-template-columns: minmax(0, 160px) minmax(0, 1fr);
    gap: 1.2rem;
    align-items: start;
  }

  .publication-with-right-image {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    gap: 1.2rem;
    align-items: start;
    overflow: visible;
  }

  .publication-side-image {
    width: 140px;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  .publication-right-image {
    display: block;
    width: 100%;
    max-width: 380px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: transform 220ms ease, box-shadow 220ms ease, background-color 220ms ease;
    transform-origin: center;
    cursor: zoom-in;
    position: relative;
    z-index: 1;
    background-color: transparent;
  }

  .publication-with-cover {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .publication-right-image.is-zoomed {
    transform: scale(2);
    box-shadow: var(--shadow-lg);
    z-index: 20;
    background-color: var(--surface);
  }

  .publication-right-image[data-zoom-anchor='left'] {
    transform-origin: left center;
  }

  .publication-right-image[data-zoom-anchor='right'] {
    transform-origin: right center;
  }

  .publication-cover-image {
    width: 140px;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  .publication-body,
  .publication-text {
    min-width: 0;
  }

  @media (max-width: 900px) {
    .publication-with-image,
    .publication-with-cover {
      display: grid;
      grid-template-columns: clamp(64px, 20vw, 120px) minmax(0, 1fr);
      gap: clamp(0.75rem, 2vw, 1rem);
      align-items: start;
    }

    .publication-with-right-image {
      grid-template-columns: 1fr;
    }

    .publication-side-image,
    .publication-cover-image {
      width: 100%;
    }

    .publication-right-image {
      max-width: 340px;
    }
  }

  .author-highlight {
    color: var(--accent);
    font-weight: 600;
  }
</style>
