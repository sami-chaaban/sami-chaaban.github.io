---
const apiBase = ''; // optional override; leave empty to use app default
const src = apiBase
  ? `/web/index.html?api=${encodeURIComponent(apiBase)}`
  : `/web/index.html`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>PPI Viewer</title>
    <style>
      html, body { margin: 0; height: 100%; background: #000; }
      iframe { width: 100%; height: 100%; border: 0; display: block; }
    </style>
  </head>
  <body>
    <iframe src={src} loading="eager" />
  </body>
</html>
