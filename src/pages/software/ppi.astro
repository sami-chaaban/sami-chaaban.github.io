---
const apiBase = 'https://sami-chaaban-github-io-1.onrender.com';
const base = import.meta.env.BASE_URL;
const appPath = `${base}ppi/index.html`;
const src = apiBase
  ? `${appPath}?api=${encodeURIComponent(apiBase)}`
  : appPath;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>PPI Viewer</title>
    <style>
      html, body { margin: 0; height: 100%; background: #000; }
      iframe { width: 100%; height: 100%; border: 0; display: block; }
    </style>
  </head>
  <body>
    <iframe src={src} loading="eager" />
  </body>
</html>
